{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PathOfLeastResistance",
  "version": "0.1.1",
  "identifier": "com.rudyc.pathofleastresistance",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PathOfLeastResistance",
        "width": 1320,
        "height": 880,
        "minWidth": 560,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "publisher": "PathOfLeastResistance",
    "shortDescription": "AI-assisted Path of Exile 2 playthrough and build manager",
    "windows": {
      "nsis": { "installMode": "currentUser" },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
